      "type": "text",
      "x": 3887.634205050478,
      "y": -371.1918783773724,
      "width": 1058.367607266611,
      "height": 225,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
