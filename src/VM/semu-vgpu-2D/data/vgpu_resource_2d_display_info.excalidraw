      "boundElements": null,
      "updated": 1773481046582,
      "link": null,
      "locked": false,
      "text": "display_info 會另外再開一個同樣大小的 buffer，並將它的\nvgpu_resource_2d.image 指向它，因此其與原始節點的 buffer 不是同一塊",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "display_info 會另外再開一個同樣大小的 buffer，並將它的 vgpu_resource_2d.image 指向它，因此其與原始節點的 buffer 不是同一塊",
      "autoResize": false,
      "lineHeight": 1.25
    },
