    {
      "id": "j4V8NG25lCFs4Wik39QpK",
      "type": "text",
      "x": 2566.691648831106,
      "y": 2231.27462423833,
      "width": 683,
      "height": 25,
      "angle": 0,
      "strokeColor": "#846358",
