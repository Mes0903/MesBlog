      ],
      "updated": 1778099483506,
      "link": null,
      "locked": false,
      "text": "（大小為 width * bytes_per_pixel * height，緊接在對應的實例後面）",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "（大小為 width * bytes_per_pixel * height，緊接在對應的實例後面）",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_FWkBzb9_wSDdry9QnhNQ",
